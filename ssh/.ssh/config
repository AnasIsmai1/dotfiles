# Portable SSH config. This file IS tracked in a public repo — keep it free of
# server hostnames, IPs, ports and usernames.
#
# Anything machine- or infrastructure-specific goes in ~/.ssh/config.local,
# which is gitignored and never leaves the machine. Include must stay at the
# top: directives are first-match-wins, and options set inside a Host block
# above it would leak into the included hosts.
Include ~/.ssh/config.local

Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_personal
    IdentitiesOnly yes

Host github-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_work
    IdentitiesOnly yes
