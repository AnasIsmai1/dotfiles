# Omarchy theme symlinks (machine-local theme state)
mako/.config/mako/config
btop/.config/btop/themes/current.theme
nvim/.config/nvim/lua/plugins/theme.lua

# Hyprland shaders (system-provided symlinks to /usr/share/aether/)
hypr/.config/hypr/shaders/

# Claude Code workspace-local settings
hypr/.config/hypr/.claude/
nvim/.config/nvim/.claude/

# Secrets / machine-local credentials
gh/.config/gh/hosts.yml
*.bak
tmux-*.log

# SSH: only the portable config is tracked. Keys, known_hosts and the
# machine-local host list (~/.ssh/config.local) must never be committed.
ssh/.ssh/*
!ssh/.ssh/config

# Claude Code: track config and hand-written skills only. Credentials, machine
# -local permissions and all session/telemetry state stay off git.
claude/.claude/.credentials.json
claude/.claude/settings.local.json
.credentials.json
